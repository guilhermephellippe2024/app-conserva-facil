alter table public.entitlements
  add column if not exists customer_phone_last4 text,
  add column if not exists auth_user_id uuid references auth.users(id) on delete set null,
  add column if not exists activated_at timestamptz;

alter table public.entitlements
  drop constraint if exists entitlements_customer_phone_last4_check;

alter table public.entitlements
  add constraint entitlements_customer_phone_last4_check
  check (customer_phone_last4 is null or customer_phone_last4 ~ '^\\d{4}$');

update public.entitlements entitlement
set auth_user_id = auth_user.id
from auth.users auth_user
where entitlement.auth_user_id is null
  and lower(entitlement.customer_email) = lower(auth_user.email);

create index if not exists entitlements_activation_lookup_idx
on public.entitlements (lower(customer_email), customer_phone_last4, status);

create table if not exists public.access_activation_attempts (
  id bigint generated by default as identity primary key,
  email_hash text not null,
  ip_hash text not null,
  succeeded boolean not null default false,
  created_at timestamptz not null default now()
);

alter table public.access_activation_attempts enable row level security;

create index if not exists activation_attempts_email_time_idx
on public.access_activation_attempts (email_hash, created_at desc);

create index if not exists activation_attempts_ip_time_idx
on public.access_activation_attempts (ip_hash, created_at desc);
