import { useState, type FormEvent } from "react";
import { Navigate, useNavigate } from "react-router-dom";
import { z } from "zod";
import { supabaseConfigured } from "../lib/supabase";
import { useAuthStore } from "../stores/authStore";

const credentialsSchema = z.object({
  email: z.string().email("Informe um e-mail válido."),
  password: z.string().min(6, "A senha precisa ter pelo menos 6 caracteres."),
});

export default function LoginPage() {
  const [message, setMessage] = useState("");
  const [busy, setBusy] = useState(false);
  const user = useAuthStore((state) => state.user);
  const signIn = useAuthStore((state) => state.signIn);
  const navigate = useNavigate();

  if (user) return <Navigate to="/" replace />;

  async function handleSubmit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    const data = new FormData(event.currentTarget);
    const parsed = credentialsSchema.safeParse({ email: data.get("email"), password: data.get("password") });
    if (!parsed.success) {
      setMessage(parsed.error.issues[0]?.message || "Revise os dados.");
      return;
    }
    setBusy(true);
    const error = await signIn(parsed.data.email, parsed.data.password);
    setBusy(false);
    if (error) setMessage(error);
    else navigate("/");
  }

  if (!supabaseConfigured) {
    return <div className="grid min-h-screen place-items-center bg-canvas p-5"><section className="w-full max-w-lg rounded-3xl border border-line bg-white p-8 text-center shadow-xl"><img src="/assets/logo-conserva-facil.png" alt="Conserva Fácil" className="mx-auto w-64" /><h1 className="mt-7 font-display text-3xl font-bold">Supabase pronto para conectar</h1><p className="mt-3 text-muted">Copie <code>.env.example</code> para <code>.env.local</code>, informe a URL e a chave pública do projeto e reinicie o app.</p><button onClick={() => navigate("/")} className="mt-6 rounded-xl bg-wine px-5 py-3 font-bold text-white">Continuar em modo demonstração</button></section></div>;
  }

  return (
    <div className="grid min-h-screen place-items-center bg-canvas p-5">
      <section className="w-full max-w-md rounded-3xl border border-line bg-white p-7 shadow-xl">
        <img src="/assets/logo-conserva-facil.png" alt="Conserva Fácil" className="mx-auto w-56" />
        <h1 className="mt-7 text-center font-display text-3xl font-bold">Entrar na minha conta</h1>
        <form onSubmit={handleSubmit} className="mt-6 grid gap-4">
          <label className="grid gap-1.5 text-sm font-bold">E-mail<input type="email" name="email" required className="field" /></label>
          <label className="grid gap-1.5 text-sm font-bold">Senha<input type="password" name="password" required minLength={6} className="field" /></label>
          {message && <p className="rounded-xl bg-blush p-3 text-sm text-wine">{message}</p>}
          <button disabled={busy} className="rounded-xl bg-wine px-5 py-3.5 font-bold text-white disabled:opacity-60">{busy ? "Aguarde..." : "Entrar"}</button>
        </form>
        <button onClick={() => { setCreating(!creating); setMessage(""); }} className="mt-4 w-full text-sm font-bold text-wine">{creating ? "Já tenho uma conta" : "Quero criar uma conta"}</button>
      </section>
    </div>
  );
}
